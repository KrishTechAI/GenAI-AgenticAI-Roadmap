from database import pool


# --------------------------------------------------
# FUNCTION 1: Get all customers
# --------------------------------------------------

def get_all_customers():

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                SELECT
                    customer_id,
                    customer_name,
                    email,
                    phone,
                    city
                FROM customers
                ORDER BY customer_id;
            """)

            rows = cursor.fetchall()

            return rows


# --------------------------------------------------
# FUNCTION 2: Get customers by city
# --------------------------------------------------

def get_customers_by_city(city):

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                SELECT
                    customer_id,
                    customer_name,
                    email,
                    phone,
                    city
                FROM customers
                WHERE city = %s
                ORDER BY customer_id;
            """, (city,))

            rows = cursor.fetchall()

            return rows


# --------------------------------------------------
# FUNCTION 3: Get one customer
# --------------------------------------------------

def get_customer(customer_id):

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                SELECT
                    customer_id,
                    customer_name,
                    email,
                    phone,
                    city
                FROM customers
                WHERE customer_id = %s;
            """, (customer_id,))

            row = cursor.fetchone()

            return row


# --------------------------------------------------
# FUNCTION 4: Add a customer
# --------------------------------------------------

def add_customer(
    customer_id,
    customer_name,
    email,
    phone,
    city
):

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                INSERT INTO customers
                (
                    customer_id,
                    customer_name,
                    email,
                    phone,
                    city
                )
                VALUES (%s, %s, %s, %s, %s);
            """, (
                customer_id,
                customer_name,
                email,
                phone,
                city
            ))

            connection.commit()

            return "Customer added successfully"


# --------------------------------------------------
# FUNCTION 5: Update customer city
# --------------------------------------------------

def update_customer_city(customer_id, city):

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                UPDATE customers
                SET city = %s
                WHERE customer_id = %s;
            """, (city, customer_id))

            connection.commit()

            return "Customer city updated successfully"


# --------------------------------------------------
# FUNCTION 6: Delete a customer
# --------------------------------------------------

def delete_customer(customer_id):

    with pool.connection() as connection:

        with connection.cursor() as cursor:

            cursor.execute("""
                DELETE FROM customers
                WHERE customer_id = %s;
            """, (customer_id,))

            connection.commit()

            return "Customer deleted successfully"


