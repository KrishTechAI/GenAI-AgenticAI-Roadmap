For Windows PowerShell, for example:

$env:OPENAI_API_KEY="your-api-key"


import os
from openai import OpenAI

client = OpenAI()

model = os.environ["OPENAI_MODEL"]

prompt = """
Explain three possible reasons for a banking payment failure.
Do not claim that you know the status of a real transaction.
"""

response = client.responses.create(
    model=model,
    input=prompt
)

answer = response.output_text

print(answer)
