|Scalar subquery|

A scalar subquery returns one value.

SELECT *
FROM employees
WHERE salary > (
    SELECT AVG(salary)
    FROM employees
);

Find employees earning the maximum salary.:

SELECT *
FROM employees
WHERE salary = (
    SELECT MAX(salary)
    FROM employees
);

Find employees earning the minimum salary.

SELECT *
FROM employees
WHERE salary = (
    SELECT MIN(salary)
    FROM employees
);
