-----------------------------------------------------------------
|Aggegate function|

| Function  | Purpose           |
| --------- | ----------------- |
| `COUNT()` | Count records     |
| `SUM()`   | Add values        |
| `AVG()`   | Calculate average |
| `MIN()`   | Find minimum      |
| `MAX()`   | Find maximum      |

1. COUNT()  ----> COUNT() counts rows or values.

SELECT COUNT(*)
FROM employees;

SELECT COUNT(*) AS employee_count
FROM employees;

# AS employee_count gives the result column a readable name.

COUNT(*)       → counts the rows
AS             → gives the result a temporary name
employee_count → the name of the result column


2. COUNT(column)

# You can also count a particular column.

SELECT COUNT(name)
FROM employees;

COUNT(*)----> Counts rows.
COUNT(column) ---> Counts non-NULL values in that column.

COUNT(*) counts rows, while COUNT(column) ignores NULL values in that column.


---------------------------------------------------------------------
|SUM()|

# SUM() adds numeric values.
gives total count

SELECT SUM(salary) AS total_salary
FROM employees;
-------------------------------------------------------
|AVG()|

#AVG() calculates the average.

SELECT AVG(salary) AS average_salary
FROM employees;
--------------------------------------------------------
|MIN()| -------------> Find the smallest value.

SELECT MIN(salary) AS minimum_salary
FROM employees;
------------------------------------------------------------
|MAX()|   -------------> Find the largest value.

SELECT MAX(salary) AS maximum_salary
FROM employees;

------------------------------------------------------
SELECT
    COUNT(*) AS employee_count,
    SUM(salary) AS total_salary,
    AVG(salary) AS average_salary,
    MIN(salary) AS minimum_salary,
    MAX(salary) AS maximum_salary
FROM employees;
