|GROUP BY multiple columns|

Number of employees in each department for each city.

SELECT
    department,
    city,
    COUNT(*) AS employee_count
FROM employees
GROUP BY department, city;

#  department + city
------------------------------------------------------
|GROUP BY + WHERE|

Find the average salary of IT employees by city.

SELECT
    city,
    AVG(salary) AS average_salary
FROM employees
WHERE department = 'IT'
GROUP BY city;

#WHERE filters rows before grouping.
--------------------------------------------------
|HAVING|

Show only departments having more than 1 employee.

SELECT
    department,
    COUNT(*) AS employee_count
FROM employees
GROUP BY department
HAVING COUNT(*) > 1;
------------------------------------------------------
|WHERE vs HAVING|

WHERE-----> Filters individual rows.
HAVING----> Filters groups after GROUP BY.

WHERE
↓
Filter rows

GROUP BY
↓
Create groups

HAVING
↓
Filter groups
--------------------------------------------------------------
|Easy example|

Find departments whose average salary is greater than 60,000.
SELECT
    department,
    AVG(salary) AS average_salary
FROM employees
GROUP BY department
HAVING AVG(salary) > 60000;

---------------------------------------------------------------------
|WHERE + GROUP BY + HAVING|

Find departments where employees earning more than 55,000 have an average salary greater than 60,000.

SELECT
    department,
    AVG(salary) AS average_salary
FROM employees
WHERE salary > 55000
GROUP BY department
HAVING AVG(salary) > 60000;
----------------------------------------------------------------------
|GROUP BY + ORDER BY|

Show departments by average salary from highest to lowest.

SELECT
    department,
    AVG(salary) AS average_salary
FROM employees
GROUP BY department
ORDER BY average_salary DESC;
