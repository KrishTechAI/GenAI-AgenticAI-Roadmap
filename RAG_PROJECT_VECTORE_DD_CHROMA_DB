from pathlib import Path
import os
import chromadb
from sentence_transformers import SentenceTransformer
from openai import OpenAI

# 1. Get the project directory
PROJECT_ROOT = Path(__file__).resolve().parent.parent

# 2. Define the ChromaDB folder
CHROMA_FOLDER = PROJECT_ROOT / "chroma_db"

# 3. Connect to ChromaDB
client = chromadb.PersistentClient(
    path=str(CHROMA_FOLDER)
)

collection = client.get_collection(
    name="banking_documents"
)

# 4. Load the embedding model
embedding_model = SentenceTransformer(
    "all-MiniLM-L6-v2"
)

# 5. Configure the OpenAI client
if not os.getenv("OPENAI_API_KEY"):
    raise ValueError(
        "OPENAI_API_KEY is not configured."
    )

llm_client = OpenAI()

# 6. Get the customer's question
question = input(
    "Ask a banking question: "
)

# 7. Convert the question into an embedding
query_embedding = embedding_model.encode(
    question,
    normalize_embeddings=True
)

# 8. Retrieve relevant chunks
if collection.count() == 0:
    raise ValueError(
        "No documents found. Run store_vectors.py first."
    )

results = collection.query(
    query_embeddings=[query_embedding.tolist()],
    n_results=min(3, collection.count()),
    include=["documents", "metadatas"]
)

retrieved_chunks = results["documents"][0]

if not retrieved_chunks:
    raise ValueError(
        "No relevant chunks were retrieved."
    )

# 9. Combine retrieved chunks into context
context = "\n\n".join(retrieved_chunks)

# 10. Create the prompt and call the LLM
response = llm_client.responses.create(
    model="gpt-4.1-mini",
    instructions=(
        "You are a banking policy assistant. "
        "Answer using only the supplied context. "
        "Do not invent banking policies or figures. "
        "If the context does not contain the answer, "
        "say that the available documents do not "
        "provide enough information."
    ),
    input=(
        f"Context:\n{context}\n\n"
        f"Customer question:\n{question}"
    )
)

# 11. Display the final answer
print("\nBanking Assistant Answer:")
print(response.output_text)


6. Interview questions and answers
Q1. What is RAG?

RAG stands for Retrieval-Augmented Generation. It retrieves relevant information from an external knowledge base and supplies that information to an LLM to generate an answer.

Q2. Why do we use an LLM in RAG?

The vector database retrieves relevant text, but it does not normally create a complete conversational answer. The LLM uses the retrieved text to generate a natural-language response.

Q3. What is context in RAG?

Context is the relevant information retrieved from the knowledge base and provided to the LLM along with the user's question.

Q4. Does RAG eliminate hallucinations?

No. RAG can reduce hallucinations by grounding answers in retrieved information, but the model may still misunderstand the context or produce unsupported statements.

Q5. What is the difference between an embedding model and an LLM?

An embedding model converts text into numerical vectors for similarity search. An LLM generates or understands text and produces responses.

Q6. Where does ChromaDB fit into RAG?

ChromaDB stores document chunks, embeddings, and metadata, and retrieves relevant chunks for a user's query.


