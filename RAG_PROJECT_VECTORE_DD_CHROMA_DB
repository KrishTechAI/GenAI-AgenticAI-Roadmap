from pathlib import Path
import chromadb
from sentence_transformers import SentenceTransformer

# 1. Get the project root directory
PROJECT_ROOT = Path(__file__).resolve().parent.parent

# 2. Define the ChromaDB folder
CHROMA_FOLDER = PROJECT_ROOT / "chroma_db"

# 3. Connect to the existing ChromaDB
client = chromadb.PersistentClient(
    path=str(CHROMA_FOLDER)
)

# 4. Access the existing collection
collection = client.get_collection(
    name="banking_documents"
)

print("Connected to ChromaDB!")
print("Total stored chunks:", collection.count())

# 5. Load the same embedding model
model = SentenceTransformer("all-MiniLM-L6-v2")

# 6. Get the customer's question
question = input("\nEnter your banking question: ")

# 7. Convert the question into an embedding
query_embedding = model.encode(
    question,
    normalize_embeddings=True
)

# 8. Retrieve the top 3 relevant chunks
if collection.count() == 0:

    print("No documents are stored in ChromaDB.")

else:

    results = collection.query(
        query_embeddings=[query_embedding.tolist()],
        n_results=min(3, collection.count()),
        include=[
            "documents",
            "metadatas",
            "distances"
        ]
    )

    # 9. Display retrieved results
    print("\nRETRIEVED RESULTS")

    for index in range(len(results["ids"][0])):

        print("\nResult:", index + 1)

        print("Chunk ID:", results["ids"][0][index])

        print("Document:")
        print(results["documents"][0][index])

        print("Metadata:")
        print(results["metadatas"][0][index])

        print("Distance:")
        print(results["distances"][0][index])


