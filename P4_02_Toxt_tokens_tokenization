Run a real open-weight LLM locally
Now let's go one step further: instead of only tokenizing text, we'll load a small instruction-tuned model and generate a response on your computer.

Architecture
Prompt
|
Tokenizer
Text → token IDs
|
Local model weights
Transformer inference on your machine
|
Generated token IDs
|
Tokenizer decodes the answer

Install dependencies: pip install torch transformers


import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

model_name = "Qwen/Qwen2.5-1.5B-Instruct"

# Load tokenizer and model
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

# Prepare a prompt
messages = [
    {
        "role": "user",
        "content": "Explain two possible reasons for a banking payment failure."
    }
]

# Convert messages into the model's expected prompt format
prompt = tokenizer.apply_chat_template(
    messages,
    tokenize=False,
    add_generation_prompt=True
)

# Convert the prompt into model input IDs
inputs = tokenizer(prompt, return_tensors="pt")

# Generate a continuation
with torch.no_grad():
    output_ids = model.generate(
        **inputs,
        max_new_tokens=100,
        do_sample=False
    )

# Remove the input tokens from the generated sequence
new_token_ids = output_ids[0][inputs["input_ids"].shape[1]:]

# Convert generated token IDs into text
answer = tokenizer.decode(
    new_token_ids,
    skip_special_tokens=True
)

print(answer)
