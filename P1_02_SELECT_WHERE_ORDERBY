FROM employees
WHERE department = 'IT'
AND salary > 60000;
-----------------------------------------------------
|OR|

#At least one condition must be true.

SELECT *
FROM employees
WHERE city = 'Chennai'
OR city = 'Bangalore';

---------------------------------------------------------
|IN|   #IN = "Is this value one of these options?"

SELECT *
FROM employees
WHERE city = 'Chennai'
OR city = 'Bangalore'
OR city = 'Mumbai';


instead:
--------------

SELECT *
FROM employees
WHERE city IN ('Chennai', 'Bangalore', 'Mumbai');

---------------------------------------------------------------------
|NOT IN|

SELECT *
FROM employees
WHERE city NOT IN ('Chennai', 'Bangalore');    #This returns employees who aren't in either city.
