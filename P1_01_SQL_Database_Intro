6. Structure 

SELECT ----> want to retrive the data
* -----> all columns
from customers -----> from customer table 
-----------------------------------------------------------------------
|Select specific column|

SELECT name, city
FROM customers;
--------------------------------------------------------
|WHERE|

SELECT *
FROM customers
WHERE city = 'Chennai';
-------------------------------------------
|Numeric filtering|

SELECT *     #select all table 
FROM customers
WHERE age > 25;


SELECT name                      #select name table 
FROM customers
WHERE age > 25;


----------------------------------------------
|Multiple conditions|

SELECT *
FROM customers
WHERE city = 'Chennai'
AND age > 25;


|OR|
SELECT *
FROM customers
WHERE city = 'Chennai'
OR city = 'Bangalore';

|NOT|

Suppose we don't want Chennai customers:
SELECT *
FROM customers
WHERE city <> 'Chennai';                 #not equal to

|BETWEEN|

SELECT *
FROM customers
WHERE age BETWEEN 25 AND 30;
