Remove blank rows without using built-in function?

import pandas as pd
df = pd.read_csv(r"F:\backup\SugumarStuffs\Data Analyst\Sample Data Files\Sample.csv")
print(df.to_string())
print(df.isnull().sum())

print("Removing Empty Rows")
i = 0
while i < len(df):
    row = df.loc[i]
    if row.isnull().sum() == len(row):
        df = df.drop(index=i)
        df = df.reset_index(drop=True)
        i = 0
    else:
        i += 1

