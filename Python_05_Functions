def clean_query(query):
    return query.strip().lower()

def build_context(documents):
    context = ""

    for document in documents:
        context += document + "\n"

    return context

def create_prompt(query, context):
    return f"""
    Answer the question using the context.

    Context:
    {context}

    Question:
    {query}
    """

