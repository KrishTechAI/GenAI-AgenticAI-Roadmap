|Real RAG-Style Example|

documents = [
    {
        "text": "Personal loan minimum age is 21.",
        "score": 0.92
    },
    {
        "text": "Credit card eligibility requires valid KYC.",
        "score": 0.85
    },
    {
        "text": "Savings accounts require identity verification.",
        "score": 0.62
    }
]

def filter_documents(documents, threshold=0.80):

    filtered_documents = []

    for document in documents:

        if document["score"] >= threshold:
            filtered_documents.append(document)

    return filtered_documents

results = filter_documents(documents)
print(results)
