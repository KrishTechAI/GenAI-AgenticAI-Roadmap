Project Query 23 — CTE

Find customers whose total account balance exceeds ₹100,000.

WITH customer_balance AS (

    SELECT
        customer_id,
        SUM(balance) AS total_balance

    FROM accounts

    GROUP BY customer_id
)

SELECT
    c.customer_id,
    c.customer_name,
    cb.total_balance

FROM customers c

JOIN customer_balance cb
    ON c.customer_id = cb.customer_id

WHERE cb.total_balance > 100000;
------------------------------------------------------------
Project Query 24 — Window Function

Rank customers based on total account balance.

WITH customer_balance AS (

    SELECT
        customer_id,
        SUM(balance) AS total_balance

    FROM accounts

    GROUP BY customer_id
)

SELECT
    c.customer_name,
    cb.total_balance,

    RANK() OVER (
        ORDER BY cb.total_balance DESC
    ) AS balance_rank

FROM customers c
JOIN customer_balance cb
    ON c.customer_id = cb.customer_id;
