Python practical: generate text using an open-source model
We'll use Hugging Face Transformers and the small GPT-2 model to demonstrate autoregressive text generation
pip install transformers torch

from transformers import AutoTokenizer, AutoModelForCausalLM

# 1. Load the tokenizer and model
model_name = "gpt2"

tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(model_name)

# 2. Prepare the input prompt
prompt = "Artificial intelligence can help banks"

inputs = tokenizer(prompt, return_tensors="pt")

# 3. Generate the continuation
outputs = model.generate(
    **inputs,
    max_new_tokens=40,
    do_sample=False,
    pad_token_id=tokenizer.eos_token_id
)

# 4. Convert token IDs back into readable text
response = tokenizer.decode(
    outputs[0],
    skip_special_tokens=True
)

print(response)
