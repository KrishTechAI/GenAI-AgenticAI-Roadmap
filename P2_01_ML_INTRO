from sklearn.tree import DecisionTreeClassifier

# Features: [monthly_transactions, complaints]
X = [
    [40, 0],
    [35, 1],
    [3, 5],
    [2, 6],
    [30, 0],
    [5, 4]
]

# Labels: 0 = stayed, 1 = left
y = [0, 0, 1, 1, 0, 1]

# Create the model
model = DecisionTreeClassifier(random_state=42)

# Train the model
model.fit(X, y)

# Predict for a new customer
new_customer = [[4, 5]]
prediction = model.predict(new_customer)

print("Prediction:", prediction[0])
-----------------------------------------------------------------------------------
Code	        Meaning
X	              Input features the model learns from
y	               Correct answers for the training examples
DecisionTreeClassifier()	| Creates a classification model
model.fit(X, y)	           |Trains the model on the examples
model.predict(...)         |	Predicts the class for new input
